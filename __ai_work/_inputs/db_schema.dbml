// ==========================================
// GUIZZLY ENGINE - DATABASE SCHEMA (DBML)
// ==========================================

// ------------------------------------------
// MULTITENANCY & USUÁRIOS
// ------------------------------------------

Table tenants {
  id serial [pk]
  name varchar(100) [not null] // Ex: "Guizzly B2B Client", "DevPrep App", "SnapQuiz App"
  api_key varchar(100) [unique, not null]
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
}

Table users {
  id serial [pk]
  tenant_id int [ref: > tenants.id]
  name varchar(100)
  email varchar(150) [unique]
  created_at timestamp [default: `now()`]
}

// ------------------------------------------
// TAXONOMIA (CATEGORIAS & ASSUNTOS)
// ------------------------------------------

Table categories {
  id serial [pk]
  tenant_id int [ref: > tenants.id]
  name varchar(100) [not null] // Ex: "Programação", "Viagens", "Cultura Pop"
  slug varchar(100) [not null]
  description text
  created_at timestamp [default: `now()`]
}

Table subjects {
  id serial [pk]
  category_id int [not null, ref: > categories.id]
  name varchar(100) [not null] // Ex: "SQL & Bancos de Dados", "Logos de TI", "Animes"
  slug varchar(100) [not null]
}

// ------------------------------------------
// QUIZZES, QUESTÕES & ALTERNATIVAS
// ------------------------------------------

Table quizzes {
  id serial [pk]
  tenant_id int [not null, ref: > tenants.id]
  subject_id int [ref: > subjects.id]
  title varchar(200) [not null]
  slug varchar(200) [not null]
  type varchar(5) [not null, default: 'study'] // 'img', 'study', 'srv', 'pers'
  description text
  cover_image_url text
  raw_yaml text // Armazena o código YAML original enviado na ingestão
  time_limit_seconds int
  is_published boolean [default: false]
  created_at timestamp [default: `now()`]
}

Table questions {
  id serial [pk]
  quiz_id int [not null, ref: > quizzes.id]
  statement text [not null] // Enunciado da questão
  code_snippet text // Bloco de código (syntax highlighting para DevPrep)
  image_url text // Imagem de apoio ou imagem principal do quiz visual
  audio_url text
  explanation text // Explicação geral do gabarito da questão
  difficulty_level varchar(5) [default: 'med'] // 'easy', 'med', 'hard'
  order_index int [default: 0]
  created_at timestamp [default: `now()`]
}

Table question_options {
  id serial [pk]
  question_id int [not null, ref: > questions.id]
  option_text text
  image_url text
  type varchar(5) [default: 'txt'] // 'txt', 'img', 'mix'
  is_correct boolean [not null, default: false]
  explanation text // Explicação específica desta alternativa
  order_index int [default: 0]
}

// ------------------------------------------
// POOLS (COLEÇÕES / DECKS DO USUÁRIO) & TAGS
// ------------------------------------------

Table pools {
  id serial [pk]
  tenant_id int [ref: > tenants.id]
  user_id int [not null, ref: > users.id] // Dono/Criador do Pool
  title varchar(150) [not null] // Ex: "Meus Simulados de SQL Sênior", "Revisão Fim de Semana"
  description text
  is_public boolean [default: false] // Permite compartilhar o deck com outros usuários
  created_at timestamp [default: `now()`]
}

Table pool_quizzes {
  id serial [pk]
  pool_id int [not null, ref: > pools.id]
  quiz_id int [not null, ref: > quizzes.id]
  order_index int [default: 0]
  added_at timestamp [default: `now()`]

  indexes {
    (pool_id, quiz_id) [unique] // Impede duplicar o mesmo quiz dentro de um mesmo pool
  }
}

Table tags {
  id serial [pk]
  tenant_id int [ref: > tenants.id]
  name varchar(50) [not null] // Ex: "golang", "sql", "logos-hd"
  slug varchar(50) [not null]
}

Table quiz_tags {
  quiz_id int [not null, ref: > quizzes.id]
  tag_id int [not null, ref: > tags.id]

  indexes {
    (quiz_id, tag_id) [pk]
  }
}

// ------------------------------------------
// HISTÓRICO DE RESPOSTAS & MÉTRICAS
// ------------------------------------------

Table user_quiz_attempts {
  id serial [pk]
  user_id int [ref: > users.id]
  quiz_id int [not null, ref: > quizzes.id]
  score decimal(5,2)
  total_questions int [not null]
  correct_answers int [not null]
  time_spent_seconds int
  completed_at timestamp [default: `now()`]
}

Table user_answers {
  id serial [pk]
  attempt_id int [not null, ref: > user_quiz_attempts.id]
  question_id int [not null, ref: > questions.id]
  selected_option_id int [ref: > question_options.id]
  is_correct boolean [not null]
  time_spent_seconds int
  created_at timestamp [default: `now()`]
}