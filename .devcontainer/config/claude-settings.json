{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun *)",
      "Bash(docker compose *)",
      "Bash(docker *)",
      "Bash(go *)",
      "Bash(git *)",
      "Bash(make *)",
      "Bash(python3 *)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Skill",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)"
    ]
  }
}
