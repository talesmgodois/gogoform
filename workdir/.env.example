# Copy to .env and adjust. Values here override config.toml.
SERVER_PORT=8080
SERVER_ENV=development
LOG_LEVEL=debug

# Pick the engine by changing the scheme: postgres:// (default) or sqlite:.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db?sslmode=disable
# DATABASE_URL=sqlite:./data/gogoform.db

# SQLite-only tuning, ignored on PostgreSQL.
# How long a writer waits for a lock before failing with SQLITE_BUSY.
# DATABASE_SQLITE_BUSY_TIMEOUT_MS=5000
# Journal mode: WAL (default, concurrent readers), DELETE or TRUNCATE.
# DATABASE_SQLITE_JOURNAL_MODE=WAL

# Apply pending migrations at startup (recorded in dbmate's schema_migrations,
# so `make migrate-*` keeps working). Defaults to true on SQLite and false on
# PostgreSQL, where migrations usually run as a separate deploy step.
# DATABASE_AUTO_MIGRATE=true

# HTTP Basic credentials of the read-only /app dashboard (disabled when unset).
APP_USERNAME=admin
APP_PASSWORD=change-me

# User authentication. AUTH_JWT_SECRET signs the access tokens (>= 32 bytes,
# e.g. `openssl rand -hex 32`); a random one is used when unset, so tokens do
# not survive a restart. The admin account is created at startup if missing.
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_MINUTES=60
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me-now
# false = SSO-only: password sign-in, sign-up and HTTP Basic on the API are
# rejected (the admin account above is still created). Default true.
# AUTH_PASSWORD_LOGIN_ENABLED=true

# Sign-in through an external OpenID Connect provider (Keycloak, Authentik,
# Auth0, Okta, Google, Microsoft Entra, GitLab, ...). Enabled when issuer,
# client id and redirect URL are all set; see docs/oidc.md.
# OIDC_ISSUER_URL=http://localhost:8081/realms/gogoform
# OIDC_CLIENT_ID=gogoform
# Optional for public clients, which rely on PKCE alone.
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=http://localhost:8080/app/oidc/callback
# Label of the "Sign in with <name>" button. Default SSO.
# OIDC_PROVIDER_NAME=Keycloak
# Comma-separated; openid is always requested. Default openid,email,profile.
# OIDC_SCOPES=openid,email,profile
# Comma-separated; when set, only users with a verified email in these
# domains may sign in.
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# Create an account on the first sign-in (default true); when false, only
# identities already linked to an account may sign in.
# OIDC_AUTO_CREATE_USERS=true
# Role of the accounts created through OIDC: ADMIN, FORM_CREATOR or BASIC.
# OIDC_DEFAULT_ROLE=BASIC

# PostgreSQL container credentials used by docker-compose.yml.
# Keep them in sync with DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db

# Host port of the Adminer web UI (docker compose service 'adminer').
ADMINER_PORT=8088
