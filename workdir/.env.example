# Copy to .env and adjust. Values here override config.toml.
SERVER_PORT=8080
SERVER_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db?sslmode=disable

# User authentication. AUTH_JWT_SECRET signs the access tokens (>= 32 bytes,
# e.g. `openssl rand -hex 32`); in development a random one is used when
# unset, so tokens do not survive a restart, but outside development
# (SERVER_ENV != "development") it is required and the server refuses to
# start without one. The admin account is created at startup if missing.
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_MINUTES=60
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me-now

# Abuse protection. SECURITY_TRUSTED_PROXIES is a comma-separated list of
# CIDR ranges (or bare IPs) whose X-Forwarded-For header is trusted for the
# real client IP; leave unset unless a reverse proxy you control sits in
# front of the app. Per-route-group rate limits are set in config.toml, not
# here. SECURITY_MIN_FORM_SECONDS rejects a public form submission filled in
# faster than a human plausibly could. TURNSTILE_SECRET enables Cloudflare
# Turnstile verification of public form submissions; TURNSTILE_SITE_KEY is
# the matching public key rendered on the form page.
SECURITY_TRUSTED_PROXIES=
SECURITY_MIN_FORM_SECONDS=2
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# Stripe billing (pro plan). The billing routes are mounted only when
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and STRIPE_PRICE_ID are all set;
# APP_BASE_URL builds the Checkout/Portal return URLs.
# Create the webhook endpoint (POST /webhooks/stripe) pinned to the API version
# of the pinned stripe-go SDK (2025-08-27.basil) so payloads decode as expected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Public origin of the app (absolute http(s) URL) for links in Stripe return
# URLs and emails; required when Stripe or SMTP is configured.
APP_BASE_URL=http://localhost:8080

# Transactional email over SMTP. Without SMTP_HOST emails are only logged.
# Port 465 uses implicit TLS, other ports STARTTLS. MAIL_FROM is required with
# SMTP_HOST, e.g. "GoGoForm <no-reply@example.com>".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# PostgreSQL container credentials used by docker-compose.yml.
# Keep them in sync with DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db

# Host port of the Adminer web UI (docker compose service 'adminer').
ADMINER_PORT=8088
