# Intermediate review reports written by runner.py. Kept out of git so the
# next /code-review doesn't review its own previous report as a change.
__ai_work/reviews/

# Python bytecode (e.g. from running __ai_work/runner.py).
__pycache__/
*.pyc

# Runner progress trackers (runtime state for resuming interrupted runs).
__ai_work/errors/track/*.json*
